{
  "name": "prime-ralph",
  "version": "0.1.0",
  "description": "A Prime Agent plugin implementing best-practice Ralph loop design in Prime Agent.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package": "./package.json",
    "./reset-context": "./src/reset-context.js",
    "./reset-extension": "./src/reset-extension.js",
    "./reset-skill": "./src/reset-skill.js",
    "./init": "./src/init.js",
    "./cli": "./src/cli.js",
    "./workflow-extension": "./src/workflow-extension.js",
    "./specification": "./src/specification.js",
    "./planning": "./src/planning.js",
    "./execution": "./src/execution.js",
    "./execution-log": "./src/execution-log.js",
    "./planning-transaction": "./src/planning-transaction.js",
    "./recovery": "./src/recovery.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "compat": "node scripts/check-prime-agent-compat.mjs",
    "package:check": "node scripts/check-package.mjs",
    "accept:reset": "node scripts/run-reset-acceptance.mjs",
    "accept:reset-busy": "node scripts/run-reset-busy-acceptance.mjs",
    "accept:reset-lifecycle": "node scripts/run-reset-lifecycle-acceptance.mjs",
    "accept:init": "node scripts/run-init-acceptance.mjs",
    "accept:package-install": "node scripts/run-package-install-acceptance.mjs",
    "accept:specification": "node scripts/run-specification-acceptance.mjs",
    "accept:model:spec-it-out": "node scripts/run-spec-it-out-model-acceptance.mjs",
    "accept:planning": "node scripts/run-planning-acceptance.mjs",
    "accept:model:plan": "node scripts/run-plan-model-acceptance.mjs",
    "accept:execution": "node scripts/run-execution-acceptance.mjs",
    "accept:execution-goal-closeout": "node scripts/run-execution-goal-closeout-acceptance.mjs",
    "accept:execution-boundary-recovery": "node scripts/run-execution-goal-closeout-acceptance.mjs --reject-boundary",
    "accept:execution-ready-handoff": "node scripts/run-execution-ready-handoff-acceptance.mjs",
    "accept:execution-pause-resume": "node scripts/run-execution-pause-resume-acceptance.mjs",
    "accept:execution-admission-failure": "node scripts/run-execution-admission-failure-acceptance.mjs",
    "accept:blocked-recovery": "node scripts/run-blocked-recovery-acceptance.mjs",
    "accept:model:execute": "node scripts/run-execute-model-acceptance.mjs",
    "accept:model:blocked-recovery": "node scripts/run-blocked-recovery-model-acceptance.mjs",
    "accept:native-acp": "node scripts/run-native-acp-acceptance.mjs",
    "accept:native-acp-prompt": "node scripts/run-native-acp-prompt-acceptance.mjs",
    "accept:native-rpc": "node scripts/run-native-rpc-acceptance.mjs",
    "accept:recovery": "node scripts/run-recovery-acceptance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "prime-agent": "0.9.3"
  },
  "license": "MIT",
  "dependencies": {
    "typebox": "^1.3.26",
    "yaml": "^2.9.0"
  },
  "bin": {
    "prime-ralph": "bin/prime-ralph.js"
  },
  "peerDependenciesMeta": {
    "prime-agent": {
      "optional": true
    }
  }
}
